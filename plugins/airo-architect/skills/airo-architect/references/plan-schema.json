{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "airo-architect plan.json",
  "type": "object",
  "required": ["target", "slug", "summary", "connections", "tests"],
  "properties": {
    "target": { "enum": ["genie", "recipe"] },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "summary": { "type": "string" },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "app", "status"],
        "properties": {
          "name": { "type": "string" },
          "app": { "type": "string" },
          "status": { "enum": ["exists", "create"] },
          "id": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "io_contract"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "io_contract": {
            "type": "object",
            "required": ["input", "output"],
            "properties": { "input": { "type": "string" }, "output": { "type": "string" } }
          },
          "source": { "enum": ["recipe", "native"] }
        }
      }
    },
    "knowledge_bases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sources"],
        "properties": {
          "name": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "ref"],
              "properties": { "type": { "enum": ["mcp", "file", "url"] }, "ref": { "type": "string" } }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": { "name": { "type": "string" }, "role": { "enum": ["chat_interface", "backing_recipe"] } }
      }
    },
    "recipe_blueprint": {
      "type": "object",
      "required": ["trigger", "steps"],
      "properties": {
        "trigger": {
          "type": "object",
          "required": ["app", "event"],
          "properties": { "app": { "type": "string" }, "event": { "type": "string" } }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["app", "action"],
            "properties": { "app": { "type": "string" }, "action": { "type": "string" }, "notes": { "type": "string" }, "step_type": { "enum": ["trigger", "action", "ai_generation", "condition"] } }
          }
        }
      }
    },
    "data_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "columns"],
        "properties": {
          "name": { "type": "string" },
          "purpose": { "enum": ["kpi", "lookup", "state"] },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "expected", "grades_on"],
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "string" },
          "expected": { "type": "string" },
          "grades_on": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "target": { "const": "recipe" } } },
      "then": { "required": ["recipe_blueprint"] } }
  ]
}
