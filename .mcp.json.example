{
  "_comment": "Copy to .mcp.json and fill in the token. .mcp.json is gitignored. Both URLs below are the Workato preview data centre, which is what this session runs on. For production swap app.preview.workato.com for app.workato.com, or your own region's host. See the README for the full region table.",

  "_comment_airo": "AIRO MCP builds. Over OAuth it needs no header at all: the client opens a browser on first use and stores the credential itself. To use a token instead, add the same Authorization header shape as the Dev API server below.",

  "mcpServers": {
    "workato-airo-mcp-preview": {
      "type": "http",
      "url": "https://app.preview.workato.com/airo_mcp"
    },

    "workato-dev-api-preview": {
      "type": "http",
      "url": "https://app.preview.workato.com/mcp",
      "headers": {
        "Authorization": "Bearer <PREVIEW_API_CLIENT_TOKEN>"
      }
    }
  }
}
